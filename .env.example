# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# No painel do Supabase: Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço: usada apenas no servidor (tela de Usuários).
# NUNCA coloque o prefixo NEXT_PUBLIC_ e NUNCA envie o .env.local para o Git.
SUPABASE_SERVICE_ROLE_KEY=
